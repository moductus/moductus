<Window x:Class="Moductus.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moductus"
        Style="{DynamicResource {x:Type Window}}"
        Width="560" Height="620"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">

    <!-- Nenhuma cor, tamanho ou raio aqui. Tudo vem dos tokens via os estilos
         implícitos de Controls.xaml; o que sobra é só layout. -->

    <Window.Resources>
        <DataTemplate x:Key="LinhaAtalho">
            <Grid MinHeight="{DynamicResource size.row}" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <!-- SharedSizeGroup: o Grid está DENTRO do template, então
                         cada linha mediria a própria coluna. "Alt+Q" e
                         "Ctrl+Shift+Alt+P" jogavam a coluna do detalhe 78px de
                         diferença entre linhas da mesma lista. -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AtalhoCombo" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Combinacao}"
                           FontFamily="{DynamicResource font.mono}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <TextBlock x:Name="Detalhe"
                           Grid.Column="1"
                           Text="{Binding Detalhe}"
                           Style="{DynamicResource style.secondary}"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Conflito}" Value="True">
                    <Setter TargetName="Detalhe" Property="Foreground" Value="{DynamicResource danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LinhaModulo">
            <Grid MinHeight="{DynamicResource size.row}" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <!-- SharedSizeGroup porque o Grid vive DENTRO do template:
                         sem isso cada linha mede a própria coluna e a descrição
                         fica serrilhada de linha para linha. -->
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModuloNome" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ModuloLetra" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding Ativo, Mode=OneWay}"
                          Content="{Binding Nome}"
                          Tag="{Binding Id}"
                          Click="OnModuloClick"
                          MinWidth="120" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Letra}"
                           FontFamily="{DynamicResource font.mono}"
                           VerticalAlignment="Center"
                           Margin="16,0" />
                <TextBlock x:Name="Detalhe"
                           Grid.Column="2"
                           Text="{Binding Detalhe}"
                           Style="{DynamicResource style.secondary}"
                           VerticalAlignment="Center" />
                <Button x:Name="Ajustar"
                        Grid.Column="3"
                        Content="Ajustar"
                        Tag="{Binding Id}"
                        Click="OnAjustarClick"
                        Margin="8,0,0,0"
                        Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Conflito}" Value="True">
                    <Setter TargetName="Detalhe" Property="Foreground" Value="{DynamicResource danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemAjuste}" Value="True">
                    <Setter TargetName="Ajustar" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg.raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
            <Setter Property="CornerRadius" Value="{DynamicResource radius.card}" />
            <Setter Property="Padding" Value="{DynamicResource inset.8}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource inset.24}">

            <TextBlock Text="Moductus" Style="{DynamicResource style.title}" Margin="0,0,0,16" />

            <Border x:Name="AvisoBorda"
                    Style="{StaticResource Cartao}"
                    BorderBrush="{DynamicResource danger}"
                    Padding="{DynamicResource inset.12}"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <TextBlock x:Name="Aviso" />
            </Border>

            <!-- Tecla líder. O campo captura a combinação pressionada; não se digita. -->
            <TextBlock Text="Tecla líder" FontWeight="{DynamicResource weight.semibold}" Margin="0,0,0,8" />
            <TextBox x:Name="Lider"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Cursor="Hand"
                     PreviewKeyDown="OnLiderKeyDown" />
            <TextBlock x:Name="LiderDetalhe"
                       Style="{DynamicResource style.caption}"
                       Margin="0,4,0,24" />

            <TextBlock Text="Módulos" FontWeight="{DynamicResource weight.semibold}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,24">
                <ItemsControl x:Name="Modulos" ItemTemplate="{StaticResource LinhaModulo}" Grid.IsSharedSizeScope="True" />
            </Border>

            <!-- Painel do módulo escolhido. Fica fora da lista de propósito:
                 montar o mesmo UserControl dentro de um item que é recriado a
                 cada Refresh esbarra no "um pai lógico só" do WPF. -->
            <Border x:Name="AjusteCartao" Style="{StaticResource Cartao}" Margin="0,0,0,24" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="8,4,8,8">
                        <Button DockPanel.Dock="Right"
                                Content="Fechar"
                                Click="OnFecharAjusteClick" />
                        <TextBlock x:Name="AjusteTitulo"
                                   FontWeight="{DynamicResource weight.semibold}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ContentControl x:Name="AjusteCorpo" Margin="8,0,8,8" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="IniciarComWindows"
                      Content="Iniciar com o Windows"
                      Click="OnAutostartClick" />
            <TextBlock x:Name="AutostartDetalhe"
                       Style="{DynamicResource style.caption}"
                       Margin="24,0,0,24" />

            <TextBlock Text="Atalhos globais" FontWeight="{DynamicResource weight.semibold}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <ItemsControl x:Name="Atalhos" ItemTemplate="{StaticResource LinhaAtalho}" Grid.IsSharedSizeScope="True" />
            </Border>

            <TextBlock x:Name="Rodape" Style="{DynamicResource style.caption}" />
        </StackPanel>
    </ScrollViewer>
</Window>

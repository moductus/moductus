<Window x:Class="Moductus.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moductus"
        Width="520" Height="440"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">

    <!-- Nenhuma cor, tamanho ou raio aqui. Tudo vem dos tokens via os estilos
         implícitos de Controls.xaml; o que sobra é só layout. -->

    <Grid Margin="{DynamicResource inset.24}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Moductus" Style="{DynamicResource text.title}" Margin="0,0,0,16" />

        <Border x:Name="AvisoBorda"
                Grid.Row="1"
                Background="{DynamicResource bg.raised}"
                BorderBrush="{DynamicResource danger}"
                BorderThickness="{DynamicResource border.width}"
                CornerRadius="{DynamicResource radius.card}"
                Padding="{DynamicResource inset.12}"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <TextBlock x:Name="Aviso" />
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,24">
            <CheckBox x:Name="IniciarComWindows"
                      Content="Iniciar com o Windows"
                      Click="OnAutostartClick" />
            <TextBlock x:Name="AutostartDetalhe"
                       Style="{DynamicResource text.caption}"
                       Margin="24,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Atalhos" FontWeight="{DynamicResource weight.semibold}" Margin="0,0,0,8" />

        <ListBox x:Name="Atalhos" Grid.Row="4" />

        <TextBlock x:Name="Rodape"
                   Grid.Row="5"
                   Style="{DynamicResource text.caption}"
                   Margin="0,12,0,0" />
    </Grid>
</Window>

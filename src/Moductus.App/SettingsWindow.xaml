<Window x:Class="Moductus.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moductus · Configurações"
        Style="{DynamicResource {x:Type Window}}"
        Width="{DynamicResource size.settings.width}"
        Height="{DynamicResource size.settings.height}"
        MinWidth="{DynamicResource size.settings.minwidth}"
        MinHeight="{DynamicResource size.settings.minheight}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">

    <!-- Nenhuma cor, tamanho ou raio aqui. Tudo vem dos tokens, pelos estilos
         de Controls.xaml; o que sobra é só layout. Os estilos locais abaixo
         existem porque só esta janela os usa, e cada um parte de um estilo
         da fundação em vez de inventar visual próprio. -->

    <Window.Resources>

        <!-- ═══ Barra lateral ═══════════════════════════════════════════ -->

        <!-- Item da barra lateral. Só o marcado é parada de Tab: a barra é um
             grupo, entra-se nele uma vez e anda-se com as setas, como na
             navegação das Configurações do Windows. -->
        <Style x:Key="Nav" TargetType="RadioButton" BasedOn="{StaticResource style.nav.item}">
            <Setter Property="GroupName" Value="Secao" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="Checked" Handler="OnSecaoChecked" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sem BasedOn de propósito: o estilo implícito de TextBlock fixaria
             a cor em text.primary, e o item não marcado precisa herdar o
             text.secondary do RadioButton. -->
        <Style x:Key="NavTexto" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- O glifo segue a cor do item pelo mesmo motivo: o style.icon fixa
             text.primary, e o ícone do item apagado ficaria aceso. -->
        <Style x:Key="NavIcone" TargetType="TextBlock" BasedOn="{StaticResource style.icon}">
            <Setter Property="FontSize" Value="{DynamicResource type.body}" />
            <Setter Property="LineHeight" Value="{DynamicResource type.body}" />
            <Setter Property="Margin" Value="{DynamicResource inset.end.12}" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>

        <!-- ═══ Controle segmentado (modo) ══════════════════════════════ -->

        <!-- Cada segmento é o ToggleButton compacto da fundação sem moldura:
             o marcado ganha o accent do próprio estilo. Mesma regra de Tab da
             barra lateral. -->
        <Style x:Key="Segmento" TargetType="RadioButton" BasedOn="{StaticResource style.toggle.compact}">
            <Setter Property="GroupName" Value="Modo" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource type.body}" />
            <EventSetter Event="Checked" Handler="OnModoChecked" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- O anel de foco mora na moldura do grupo, e não no segmento: o
             segmento focado é sempre o marcado, e no Grafite o accent do
             preenchimento é a mesma tinta do accent.border — a borda dele
             sumiria. -->
        <Style x:Key="SegmentoMoldura" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg.inset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
            <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
            <Setter Property="Padding" Value="{DynamicResource inset.4}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource accent.border}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Campos e caixas ═════════════════════════════════════════ -->

        <!-- O campo que captura a tecla líder. Não é TextBox: não se digita
             nele, e a combinação aparece desenhada em keycaps em vez de
             texto. Rebaixado como o campo de busca, foco em accent.border. -->
        <Style x:Key="CampoCaptura" TargetType="Border">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource bg.inset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
            <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
            <Setter Property="Padding" Value="{DynamicResource inset.input}" />
            <Setter Property="MinHeight" Value="{DynamicResource size.input.search}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource border.strong}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource accent.border}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Erro inline: o véu de danger no fundo e a borda cheia. O texto
             fica em text.primary — vermelho sobre véu vermelho cansa a
             leitura de uma frase inteira; quem sinaliza é o ícone e a borda. -->
        <Style x:Key="CaixaErro" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource danger.veil}" />
            <Setter Property="BorderBrush" Value="{DynamicResource danger}" />
            <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
            <Setter Property="CornerRadius" Value="{DynamicResource radius.control}" />
            <Setter Property="Padding" Value="{DynamicResource inset.12}" />
        </Style>

        <Style x:Key="IconeErro" TargetType="TextBlock" BasedOn="{StaticResource style.icon}">
            <Setter Property="FontSize" Value="{DynamicResource type.body}" />
            <Setter Property="LineHeight" Value="{DynamicResource type.body.line}" />
            <Setter Property="Foreground" Value="{DynamicResource danger}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="{DynamicResource inset.end.8}" />
        </Style>

        <!-- Cartão que carrega uma lista: sem folga própria, porque cada linha
             já traz a dela e o divisor precisa ir de borda a borda. -->
        <Style x:Key="CartaoLista" TargetType="Border" BasedOn="{StaticResource style.card}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- O "Ajustar" da linha de módulo: fantasma, e compacto porque mora
             dentro da linha de 36. -->
        <Style x:Key="BotaoLinha" TargetType="Button" BasedOn="{StaticResource style.button.ghost}">
            <Setter Property="Height" Value="{DynamicResource size.button.compact}" />
            <Setter Property="Padding" Value="{DynamicResource inset.button.compact}" />
        </Style>

        <!-- ═══ Modelos ═════════════════════════════════════════════════ -->

        <DataTemplate x:Key="Tecla">
            <Border Style="{DynamicResource style.keycap}" Margin="{DynamicResource inset.settings.keycap}">
                <TextBlock Text="{Binding}" Style="{DynamicResource style.keycap.text}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TeclaGrande">
            <Border Style="{DynamicResource style.keycap.lg}" Margin="{DynamicResource inset.settings.keycap}">
                <TextBlock Text="{Binding}" Style="{DynamicResource style.keycap.lg.text}" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Horizontal">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Linha de lista dentro de um cartão: divisor em cima, menos na
             primeira, que já encosta na borda do próprio cartão. -->
        <Style x:Key="LinhaCartao" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource border.width.top}" />
            <Setter Property="Padding" Value="{DynamicResource inset.row}" />
            <Setter Property="MinHeight" Value="{DynamicResource size.row}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="LinhaModulo">
            <Border Style="{StaticResource LinhaCartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- O switch, e não a caixa de marcar: ligar o módulo vale
                         na hora, não depois de um "Salvar". -->
                    <CheckBox Grid.Column="0"
                              Style="{DynamicResource style.switch}"
                              IsChecked="{Binding Ativo, Mode=OneWay}"
                              Tag="{Binding Id}"
                              Click="OnModuloClick"
                              AutomationProperties.Name="{Binding Nome}" />
                    <StackPanel x:Name="Textos"
                                Grid.Column="1"
                                Margin="{DynamicResource inset.start.12}"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nome}" FontWeight="{DynamicResource weight.semibold}" />
                        <TextBlock x:Name="Detalhe"
                                   Text="{Binding Detalhe}"
                                   Style="{DynamicResource style.caption}" />
                    </StackPanel>
                    <Border x:Name="Tecla"
                            Grid.Column="2"
                            Style="{DynamicResource style.keycap}"
                            Margin="{DynamicResource inset.start.12}"
                            ToolTip="Letra depois da tecla líder">
                        <TextBlock Text="{Binding Letra}" Style="{DynamicResource style.keycap.text}" />
                    </Border>
                    <!-- Hidden, e não Collapsed: o botão ausente continua
                         guardando a vaga, e a coluna de letras fica alinhada
                         entre o módulo que tem ajuste e o que não tem. -->
                    <Button x:Name="Ajustar"
                            Grid.Column="3"
                            Style="{StaticResource BotaoLinha}"
                            Content="Ajustar"
                            Tag="{Binding Id}"
                            Click="OnAjustarClick"
                            Margin="{DynamicResource inset.start.12}"
                            Visibility="Hidden" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Conflito}" Value="True">
                    <Setter TargetName="Detalhe" Property="Foreground" Value="{DynamicResource danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TemAjuste}" Value="True">
                    <Setter TargetName="Ajustar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Desligado fica atenuado, não escondido: a pessoa precisa
                     ver o que pode ligar. O switch não atenua — é ele que se
                     procura para religar. -->
                <DataTrigger Binding="{Binding Ativo}" Value="False">
                    <Setter TargetName="Textos" Property="Opacity" Value="{DynamicResource opacity.disabled}" />
                    <Setter TargetName="Tecla" Property="Opacity" Value="{DynamicResource opacity.disabled}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="LinhaAtalho">
            <Border Style="{StaticResource LinhaCartao}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- SharedSizeGroup: o Grid está DENTRO do template,
                             então cada linha mediria a própria coluna, e
                             "Alt+Q" ao lado de "Ctrl+Shift+Alt+P" serrilhava
                             o detalhe de linha para linha. -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AtalhoCombo" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0"
                                  ItemsSource="{Binding Teclas}"
                                  ItemTemplate="{StaticResource Tecla}"
                                  ItemsPanel="{StaticResource Horizontal}"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  Margin="{DynamicResource inset.end.12}" />
                    <TextBlock x:Name="Detalhe"
                               Grid.Column="1"
                               Text="{Binding Detalhe}"
                               Style="{DynamicResource style.secondary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Conflito}" Value="True">
                    <Setter TargetName="Detalhe" Property="Foreground" Value="{DynamicResource danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ Grade de temas ══════════════════════════════════════════ -->

        <!-- A lista de temas é uma ListBox para ganhar de graça a seleção por
             setas e a semântica de "um escolhido". Sem ScrollViewer próprio:
             quem rola é a seção, e um rolador aninhado comeria a roda do
             mouse em cima dos cartões. -->
        <Style x:Key="GradeTemas" TargetType="ListBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="{DynamicResource inset.settings.theme.grid}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- O cartão de um tema. A seleção é um anel de 2px por cima do
             cartão, e não a borda dele engrossando: trocar a espessura
             empurraria o conteúdo 1px a cada escolha. -->
        <Style x:Key="CartaoTema" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Nome}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Descricao}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="{DynamicResource inset.4}">
                            <Border x:Name="Cartao"
                                    Background="{DynamicResource bg.raised}"
                                    BorderBrush="{DynamicResource border.subtle}"
                                    BorderThickness="{DynamicResource border.width}"
                                    CornerRadius="{DynamicResource radius.card}"
                                    Padding="{DynamicResource inset.12}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Selecao"
                                    BorderBrush="{DynamicResource accent.border}"
                                    BorderThickness="{DynamicResource border.width.strong}"
                                    CornerRadius="{DynamicResource radius.card}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cartao" Property="Background" Value="{DynamicResource bg.hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cartao" Property="Background" Value="{DynamicResource bg.hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selecao" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Como na barra lateral: o Tab cai no tema escolhido, e não
                     no primeiro da grade. -->
                <Trigger Property="IsSelected" Value="False">
                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A miniatura pinta com as cores DO TEMA do cartão, não com as do
             tema em vigor: os pincéis vêm do item, lidos do próprio XAML do
             tema. Só o desenho — tamanho, raio, folga — vem dos tokens. -->
        <DataTemplate x:Key="Tema">
            <StackPanel>
                <Border Height="{DynamicResource size.theme.preview}"
                        Background="{Binding Base}"
                        BorderBrush="{Binding Borda}"
                        BorderThickness="{DynamicResource border.width}"
                        CornerRadius="{DynamicResource radius.control}"
                        Padding="{DynamicResource inset.8}"
                        Margin="{DynamicResource inset.bottom.8}">
                    <Border Background="{Binding Elevado}"
                            BorderBrush="{Binding Borda}"
                            BorderThickness="{DynamicResource border.width}"
                            CornerRadius="{DynamicResource radius.control}"
                            Padding="{DynamicResource inset.8}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="{DynamicResource space.4}"
                                        Background="{Binding Texto}"
                                        CornerRadius="{DynamicResource radius.theme.line}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="{DynamicResource inset.y.4}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="{DynamicResource space.4}"
                                        Background="{Binding Mudo}"
                                        CornerRadius="{DynamicResource radius.theme.line}" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Width="{DynamicResource space.24}"
                                        Height="{DynamicResource space.8}"
                                        Background="{Binding Destaque}"
                                        CornerRadius="{DynamicResource radius.theme.accent}" />
                                <Ellipse Style="{DynamicResource style.dot}"
                                         Fill="{Binding Sucesso}"
                                         Margin="{DynamicResource inset.start.8}" />
                                <Ellipse Style="{DynamicResource style.dot}"
                                         Fill="{Binding Perigo}"
                                         Margin="{DynamicResource inset.start.8}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
                <DockPanel>
                    <TextBlock x:Name="Marca"
                               DockPanel.Dock="Right"
                               Text="&#xE73E;"
                               Style="{DynamicResource style.icon}"
                               Foreground="{DynamicResource accent.text}"
                               Visibility="Collapsed" />
                    <TextBlock Text="{Binding Nome}"
                               FontWeight="{DynamicResource weight.semibold}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding Descricao}" Style="{DynamicResource style.caption}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Auto, com a largura no Border: ColumnDefinition quer GridLength,
                 e o token é um número. -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Barra lateral ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Width="{DynamicResource size.nav.width}"
                BorderBrush="{DynamicResource border.subtle}"
                BorderThickness="{DynamicResource border.width.nav}"
                Padding="{DynamicResource inset.12}">
            <StackPanel x:Name="Navegacao"
                        KeyboardNavigation.TabNavigation="Once"
                        PreviewKeyDown="OnGrupoKeyDown">
                <TextBlock Text="PREFERÊNCIAS"
                           Style="{DynamicResource style.section}"
                           Margin="{DynamicResource inset.field.status}" />

                <RadioButton x:Name="NavGeral" Style="{StaticResource Nav}">
                    <DockPanel>
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavIcone}" />
                        <TextBlock Text="Geral" Style="{StaticResource NavTexto}" />
                    </DockPanel>
                </RadioButton>

                <RadioButton x:Name="NavLider" Style="{StaticResource Nav}">
                    <DockPanel>
                        <TextBlock Text="&#xE765;" Style="{StaticResource NavIcone}" />
                        <!-- Ponto de atenção: a líder está em conflito. Não é o
                             único sinal — a seção explica em texto. -->
                        <Ellipse x:Name="NavLiderAlerta"
                                 DockPanel.Dock="Right"
                                 Style="{DynamicResource style.dot.danger}"
                                 Visibility="Collapsed" />
                        <TextBlock Text="Tecla líder" Style="{StaticResource NavTexto}" />
                    </DockPanel>
                </RadioButton>

                <RadioButton x:Name="NavModulos" Style="{StaticResource Nav}">
                    <DockPanel>
                        <TextBlock Text="&#xECA5;" Style="{StaticResource NavIcone}" />
                        <Border DockPanel.Dock="Right" Style="{DynamicResource style.chip}">
                            <TextBlock x:Name="NavModulosContagem" Style="{DynamicResource style.chip.text}" />
                        </Border>
                        <Ellipse x:Name="NavModulosAlerta"
                                 DockPanel.Dock="Right"
                                 Style="{DynamicResource style.dot.danger}"
                                 Margin="{DynamicResource inset.end.8}"
                                 Visibility="Collapsed" />
                        <TextBlock Text="Módulos" Style="{StaticResource NavTexto}" />
                    </DockPanel>
                </RadioButton>

                <RadioButton x:Name="NavAparencia" Style="{StaticResource Nav}">
                    <DockPanel>
                        <TextBlock Text="&#xE790;" Style="{StaticResource NavIcone}" />
                        <TextBlock Text="Aparência" Style="{StaticResource NavTexto}" />
                    </DockPanel>
                </RadioButton>

                <RadioButton x:Name="NavAtalhos" Style="{StaticResource Nav}">
                    <DockPanel>
                        <TextBlock Text="&#xE945;" Style="{StaticResource NavIcone}" />
                        <Ellipse x:Name="NavAtalhosAlerta"
                                 DockPanel.Dock="Right"
                                 Style="{DynamicResource style.dot.danger}"
                                 Visibility="Collapsed" />
                        <TextBlock Text="Atalhos globais" Style="{StaticResource NavTexto}" />
                    </DockPanel>
                </RadioButton>

                <RadioButton x:Name="NavSobre" Style="{StaticResource Nav}">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource NavIcone}" />
                        <TextBlock Text="Sobre" Style="{StaticResource NavTexto}" />
                    </DockPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ═══ Conteúdo ════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="Rolagem"
                      Grid.Row="0"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <!-- Coluna com teto e alinhada à esquerda: o StackPanel com
                 MaxWidth sozinho centralizaria, e alinhado à esquerda sem a
                 coluna encolheria até o texto mais longo da seção. -->
            <Grid Margin="{DynamicResource inset.24}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{DynamicResource size.settings.content}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">

                    <!-- O aviso de config vale para a janela inteira, então fica
                         acima de qualquer seção: quem abre as configurações com o
                         arquivo quebrado precisa ver isso antes de mexer. -->
                    <Border x:Name="AvisoBorda"
                            Style="{StaticResource CaixaErro}"
                            Margin="{DynamicResource inset.settings.group}"
                            Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Text="&#xE783;" Style="{StaticResource IconeErro}" />
                            <TextBlock x:Name="Aviso" />
                        </DockPanel>
                    </Border>

                    <!-- ─── Geral ─────────────────────────────────────────── -->
                    <StackPanel x:Name="SecaoGeral">
                        <TextBlock Text="Geral" Style="{DynamicResource style.title}" />
                        <TextBlock Text="Como o Moductus convive com o Windows."
                                   Style="{DynamicResource style.secondary}"
                                   Margin="{DynamicResource inset.detail}" />

                        <Border Style="{DynamicResource style.card}" Margin="{DynamicResource inset.settings.group}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="IniciarComWindows"
                                              DockPanel.Dock="Right"
                                              Style="{DynamicResource style.switch}"
                                              AutomationProperties.Name="Iniciar com o Windows"
                                              Click="OnAutostartClick" />
                                    <StackPanel VerticalAlignment="Center" Margin="{DynamicResource inset.end.12}">
                                        <TextBlock Text="Iniciar com o Windows" FontWeight="{DynamicResource weight.semibold}" />
                                        <TextBlock x:Name="AutostartDetalhe" Style="{DynamicResource style.caption}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Entrada apontando para outra cópia é defeito, não
                                     estado: o Windows vai subir um executável que não é
                                     este. Sai no mesmo erro inline da tecla líder, para
                                     não passar como mais uma linha de legenda. -->
                                <Border x:Name="AutostartErroBorda"
                                        Style="{StaticResource CaixaErro}"
                                        Margin="{DynamicResource inset.top.8}"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock Text="&#xE783;" Style="{StaticResource IconeErro}" />
                                        <TextBlock x:Name="AutostartErro" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─── Tecla líder ───────────────────────────────────── -->
                    <StackPanel x:Name="SecaoLider" Visibility="Collapsed">
                        <TextBlock Text="Tecla líder" Style="{DynamicResource style.title}" />
                        <TextBlock Text="O atalho que abre o overlay das letras. Depois dele, uma letra escolhe o módulo."
                                   Style="{DynamicResource style.secondary}"
                                   Margin="{DynamicResource inset.detail}" />

                        <Border Style="{DynamicResource style.card}" Margin="{DynamicResource inset.settings.group}">
                            <StackPanel>
                                <TextBlock Text="Atalho principal" FontWeight="{DynamicResource weight.semibold}" />
                                <TextBlock x:Name="LiderDetalhe"
                                           Style="{DynamicResource style.caption}"
                                           Margin="{DynamicResource inset.detail}" />

                                <!-- O campo captura a combinação pressionada; não se
                                     digita. Esc continua fechando a janela, e Tab
                                     continua saindo do campo. -->
                                <Border x:Name="LiderCampo"
                                        Style="{StaticResource CampoCaptura}"
                                        AutomationProperties.Name="Tecla líder"
                                        AutomationProperties.HelpText="Pressione a combinação nova, com pelo menos um modificador."
                                        PreviewKeyDown="OnLiderKeyDown"
                                        MouseLeftButtonDown="OnLiderMouseDown"
                                        GotKeyboardFocus="OnLiderFoco"
                                        LostKeyboardFocus="OnLiderFoco">
                                    <DockPanel>
                                        <Border x:Name="LiderEstado" DockPanel.Dock="Right" Style="{DynamicResource style.chip}">
                                            <TextBlock x:Name="LiderEstadoTexto" Style="{DynamicResource style.chip.text}" />
                                        </Border>
                                        <ItemsControl x:Name="LiderTeclas"
                                                      ItemTemplate="{StaticResource TeclaGrande}"
                                                      ItemsPanel="{StaticResource Horizontal}"
                                                      Focusable="False"
                                                      VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <Border x:Name="LiderErroBorda"
                                        Style="{StaticResource CaixaErro}"
                                        Margin="{DynamicResource inset.top.8}"
                                        Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock Text="&#xE783;" Style="{StaticResource IconeErro}" />
                                        <TextBlock x:Name="LiderErro" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─── Módulos ───────────────────────────────────────── -->
                    <StackPanel x:Name="SecaoModulos" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="ModulosResumo"
                                       DockPanel.Dock="Right"
                                       Style="{DynamicResource style.caption}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="Módulos" Style="{DynamicResource style.title}" />
                        </DockPanel>
                        <TextBlock Text="Cada módulo ligado responde a uma letra depois da tecla líder. Desligado, ele não roda nem ocupa a letra."
                                   Style="{DynamicResource style.secondary}"
                                   Margin="{DynamicResource inset.detail}" />

                        <Border Style="{StaticResource CartaoLista}" Margin="{DynamicResource inset.settings.group}">
                            <ItemsControl x:Name="Modulos" ItemTemplate="{StaticResource LinhaModulo}" Focusable="False" />
                        </Border>
                    </StackPanel>

                    <!-- ─── Aparência ─────────────────────────────────────── -->
                    <StackPanel x:Name="SecaoAparencia" Visibility="Collapsed">
                        <TextBlock Text="Aparência" Style="{DynamicResource style.title}" />
                        <TextBlock Text="Vale na hora, para todas as janelas do Moductus."
                                   Style="{DynamicResource style.secondary}"
                                   Margin="{DynamicResource inset.detail}" />

                        <Border x:Name="AltoContrasteAviso"
                                Style="{DynamicResource style.card}"
                                Margin="{DynamicResource inset.settings.group}"
                                Visibility="Collapsed">
                            <TextBlock Text="O alto contraste do Windows está ligado e usa as cores do sistema por cima do tema. A escolha abaixo fica guardada e volta quando ele for desligado."
                                       Style="{DynamicResource style.secondary}" />
                        </Border>

                        <StackPanel Margin="{DynamicResource inset.settings.group}">
                            <TextBlock Text="TEMA" Style="{DynamicResource style.section}" Margin="{DynamicResource inset.bottom.8}" />
                            <!-- O recuo negativo da grade é compensado pela folga de
                                 cada cartão; ver inset.settings.theme.grid. -->
                            <Border>
                                <ListBox x:Name="Temas"
                                         Style="{StaticResource GradeTemas}"
                                         ItemContainerStyle="{StaticResource CartaoTema}"
                                         ItemTemplate="{StaticResource Tema}"
                                         SelectedValuePath="Id"
                                         AutomationProperties.Name="Tema"
                                         PreviewKeyDown="OnTemasKeyDown"
                                         SelectionChanged="OnTemaSelectionChanged" />
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="{DynamicResource inset.settings.group}">
                            <TextBlock Text="MODO" Style="{DynamicResource style.section}" Margin="{DynamicResource inset.bottom.8}" />
                            <Border Style="{StaticResource SegmentoMoldura}">
                                <UniformGrid x:Name="Modos"
                                             Rows="1"
                                             KeyboardNavigation.TabNavigation="Once"
                                             PreviewKeyDown="OnGrupoKeyDown"
                                             AutomationProperties.Name="Modo">
                                    <RadioButton x:Name="ModoSistema" Style="{StaticResource Segmento}" Content="Sistema" />
                                    <RadioButton x:Name="ModoClaro" Style="{StaticResource Segmento}" Content="Claro" />
                                    <RadioButton x:Name="ModoEscuro" Style="{StaticResource Segmento}" Content="Escuro" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Sistema acompanha o claro ou escuro do Windows e muda junto com ele."
                                       Style="{DynamicResource style.caption}"
                                       Margin="{DynamicResource inset.top.8}" />
                        </StackPanel>

                        <TextBlock Text="OPACIDADE" Style="{DynamicResource style.section}" Margin="{DynamicResource inset.bottom.8}" />
                        <!-- Global porque a pastilha não é de módulo nenhum. -->
                        <Border Style="{DynamicResource style.card}" Margin="{DynamicResource inset.settings.group}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="OpacidadeCampo"
                                             Width="{DynamicResource size.settings.field}"
                                             HorizontalContentAlignment="Right"
                                             AutomationProperties.Name="Opacidade das superfícies, em porcentagem"
                                             LostFocus="OnOpacidadeLostFocus"
                                             PreviewKeyDown="OnOpacidadeKeyDown" />
                                    <TextBlock Text="%"
                                               Style="{DynamicResource style.secondary}"
                                               VerticalAlignment="Center"
                                               Margin="{DynamicResource inset.start.8}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="{DynamicResource inset.end.12}">
                                    <TextBlock Text="Opacidade das superfícies" FontWeight="{DynamicResource weight.semibold}" />
                                    <TextBlock x:Name="OpacidadeDetalhe" Style="{DynamicResource style.caption}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─── Atalhos globais ───────────────────────────────── -->
                    <StackPanel x:Name="SecaoAtalhos" Visibility="Collapsed">
                        <TextBlock Text="Atalhos globais" Style="{DynamicResource style.title}" />
                        <TextBlock Text="As combinações que o Moductus registrou no Windows e quem responde a cada uma."
                                   Style="{DynamicResource style.secondary}"
                                   Margin="{DynamicResource inset.detail}" />

                        <Border Style="{StaticResource CartaoLista}" Margin="{DynamicResource inset.settings.group}">
                            <Grid>
                                <ItemsControl x:Name="Atalhos"
                                              ItemTemplate="{StaticResource LinhaAtalho}"
                                              Grid.IsSharedSizeScope="True"
                                              Focusable="False" />
                                <TextBlock x:Name="AtalhosVazio"
                                           Text="Nenhum atalho global registrado ainda. A tecla líder aparece aqui assim que o Windows a aceitar."
                                           Style="{DynamicResource style.secondary}"
                                           Margin="{DynamicResource inset.16}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ─── Sobre ─────────────────────────────────────────── -->
                    <StackPanel x:Name="SecaoSobre" Visibility="Collapsed">
                        <TextBlock Text="Sobre" Style="{DynamicResource style.title}" />
                        <TextBlock Text="Suíte de utilitários para Windows, open source, em processo único, acionada por teclado."
                                   Style="{DynamicResource style.secondary}"
                                   Margin="{DynamicResource inset.detail}" />

                        <Border Style="{DynamicResource style.card}" Margin="{DynamicResource inset.settings.group}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Style="{DynamicResource style.keycap.lg.accent}"
                                            Margin="{DynamicResource inset.end.12}">
                                        <TextBlock Text="M" Style="{DynamicResource style.keycap.lg.text}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Moductus" FontWeight="{DynamicResource weight.semibold}" />
                                        <TextBlock Text="Open source · licença MIT" Style="{DynamicResource style.caption}" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="{DynamicResource inset.top.8}">
                                    <Ellipse Style="{DynamicResource style.dot.success}" Margin="{DynamicResource inset.end.8}" />
                                    <TextBlock Text="Zero telemetria · zero rede" Style="{DynamicResource style.secondary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══ Rodapé ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource border.subtle}"
                BorderThickness="{DynamicResource border.width.top}"
                Padding="{DynamicResource inset.settings.footer}">
            <DockPanel>
                <!-- As dicas centram na altura da keycap, como o caminho à direita
                     centra na do rodapé. Esticadas, como o StackPanel deixa por
                     padrão, elas encostavam no topo da linha e ficavam acima do
                     caminho. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentPresenter Content="↑↓" ContentTemplate="{StaticResource Tecla}" />
                    <TextBlock Text="navegar" Style="{DynamicResource style.caption}" Margin="{DynamicResource inset.end.12}" VerticalAlignment="Center" />
                    <ContentPresenter Content="Tab" ContentTemplate="{StaticResource Tecla}" />
                    <TextBlock Text="próximo" Style="{DynamicResource style.caption}" Margin="{DynamicResource inset.end.12}" VerticalAlignment="Center" />
                    <ContentPresenter Content="Esc" ContentTemplate="{StaticResource Tecla}" />
                    <TextBlock Text="fechar" Style="{DynamicResource style.caption}" Margin="{DynamicResource inset.end.12}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Onde a config mora. Caminho longo corta com reticências, e
                     o inteiro fica na dica. -->
                <TextBlock x:Name="Rodape"
                           Style="{DynamicResource style.caption}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

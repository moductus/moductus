<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Per-Monitor DPI V2 é declarado aqui, não em código. Ver ARCHITECTURE.md §6.3. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Alt+Tab, Explorer e taskbar fixado. A bandeja não usa isto: ela pede
         bitmap no tamanho e no tema do momento, e quem desenha é o Mark. -->
    <ApplicationIcon>..\..\assets\moductus.ico</ApplicationIcon>
    <!-- O nome do processo no Gerenciador de Tarefas é Moductus.exe. -->
    <AssemblyName>Moductus</AssemblyName>
    <RootNamespace>Moductus.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moductus.Core\Moductus.Core.csproj" />
    <ProjectReference Include="..\Moductus.UI\Moductus.UI.csproj" />
    <ProjectReference Include="..\Moductus.Modules\Moductus.Modules.csproj" />
  </ItemGroup>

</Project>

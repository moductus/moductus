<Window x:Class="Moductus.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moductus — como usar"
        Style="{DynamicResource {x:Type Window}}"
        Width="620" Height="680"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">

    <!-- Nenhuma cor, tamanho ou raio aqui: tudo vem dos tokens. -->

    <Window.Resources>
        <!-- Linha de passo: as teclas desenhadas como keycaps — as mesmas da
             janela principal e do overlay da líder —, texto ao lado. -->
        <DataTemplate x:Key="LinhaPasso">
            <Grid Margin="{DynamicResource inset.home.divider}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PassoTecla" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Teclas}"
                              Focusable="False"
                              VerticalAlignment="Top"
                              Margin="{DynamicResource inset.end.12}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource style.keycap.lg}"
                                    Margin="{DynamicResource inset.home.keycap}">
                                <TextBlock Text="{Binding}" Style="{DynamicResource style.keycap.lg.text}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Titulo}" FontWeight="{DynamicResource weight.semibold}" />
                    <TextBlock Text="{Binding Detalhe}" Style="{DynamicResource style.secondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource bg.raised}"
                BorderBrush="{DynamicResource border.subtle}"
                BorderThickness="{DynamicResource border.width.top}"
                Padding="{DynamicResource inset.home.footer}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Fechar"
                        Style="{DynamicResource style.button.ghost}"
                        Click="OnFecharClick" />
                <CheckBox x:Name="NaoMostrarMais"
                          Content="Não abrir isto quando o Moductus iniciar"
                          VerticalAlignment="Center"
                          Click="OnNaoMostrarClick" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource inset.24}">

                <TextBlock Text="Tudo a uma tecla de distância" Style="{DynamicResource style.title}" />
                <TextBlock Style="{DynamicResource style.secondary}" Margin="{DynamicResource inset.y.4}"
                           Text="O Moductus mora na bandeja e aparece quando você chama. A janela principal abre no clique do ícone." />

                <TextBlock Text="OS TRÊS PASSOS"
                           Style="{DynamicResource style.section}"
                           Margin="{DynamicResource inset.help.section}" />
                <Border Style="{DynamicResource style.card}">
                    <ItemsControl x:Name="Passos"
                                  Focusable="False"
                                  Grid.IsSharedSizeScope="True"
                                  ItemTemplate="{StaticResource LinhaPasso}" />
                </Border>

                <TextBlock Text="SE A TECLA LÍDER NÃO RESPONDER"
                           Style="{DynamicResource style.section}"
                           Margin="{DynamicResource inset.help.section}" />
                <Border Style="{DynamicResource style.card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="O Windows entrega uma hotkey global a um aplicativo só, e não avisa quem perdeu a disputa — o atalho simplesmente não funciona. Se outro programa já registrou a combinação, a tela de configurações mostra o conflito e o nome de quem está segurando." />
                        <TextBlock TextWrapping="Wrap" Margin="{DynamicResource inset.top.8}"
                                   Text="Enquanto isso, clique com o botão direito no ícone da bandeja: todo módulo ativo está lá, com os comandos de cada um em submenu." />
                    </StackPanel>
                </Border>

                <TextBlock Text="ONDE VER O QUE ESTÁ LIGADO"
                           Style="{DynamicResource style.section}"
                           Margin="{DynamicResource inset.help.section}" />
                <Border Style="{DynamicResource style.card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Estado que dura — microfone mudo, Awake ligado, pomodoro contando — aparece como pastilha no canto inferior direito. Clicar na pastilha desfaz, sem precisar do atalho de novo." />
                        <TextBlock TextWrapping="Wrap" Margin="{DynamicResource inset.top.8}"
                                   Text="O ícone da bandeja também muda: o pomodoro desenha o progresso em volta dele e o microfone mudo ganha um risco. Se você não enxerga o ícone, ele está atrás da setinha de estouro do Windows — arraste-o para fora para fixar." />
                    </StackPanel>
                </Border>

                <TextBlock Text="OS MÓDULOS"
                           Style="{DynamicResource style.section}"
                           Margin="{DynamicResource inset.help.section}" />
                <Border Style="{DynamicResource style.card}">
                    <ItemsControl x:Name="Modulos"
                                  Focusable="False"
                                  Grid.IsSharedSizeScope="True"
                                  ItemTemplate="{StaticResource LinhaPasso}" />
                </Border>

                <TextBlock Text="PRIVACIDADE"
                           Style="{DynamicResource style.section}"
                           Margin="{DynamicResource inset.help.section}" />
                <Border Style="{DynamicResource style.card}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Zero telemetria e zero rede: o aplicativo não faz nenhuma requisição HTTP, nem para checar atualização. O repositório é público desde o primeiro commit justamente porque um programa que registra hotkeys globais e lê o clipboard precisa ser auditável para merecer confiança." />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="Moductus.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moductus — como usar"
        Style="{DynamicResource {x:Type Window}}"
        Width="620" Height="680"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">

    <!-- Nenhuma cor, tamanho ou raio aqui: tudo vem dos tokens. -->

    <Window.Resources>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg.raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
            <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
            <Setter Property="CornerRadius" Value="{DynamicResource radius.card}" />
            <Setter Property="Padding" Value="{DynamicResource inset.16}" />
        </Style>

        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="{DynamicResource weight.semibold}" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>

        <!-- Linha de passo: número em mono, texto ao lado. -->
        <DataTemplate x:Key="LinhaPasso">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PassoTecla" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{DynamicResource bg.base}"
                        BorderBrush="{DynamicResource border.strong}"
                        BorderThickness="{DynamicResource border.width}"
                        CornerRadius="{DynamicResource radius.control}"
                        Padding="{DynamicResource inset.8}"
                        VerticalAlignment="Top"
                        Margin="0,0,12,0">
                    <TextBlock Text="{Binding Tecla}"
                               FontFamily="{DynamicResource font.mono}"
                               Foreground="{DynamicResource accent}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Titulo}" FontWeight="{DynamicResource weight.semibold}" />
                    <TextBlock Text="{Binding Detalhe}" Style="{DynamicResource style.secondary}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource bg.raised}"
                BorderBrush="{DynamicResource border.subtle}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource inset.16}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fechar" Click="OnFecharClick" />
                <CheckBox x:Name="NaoMostrarMais"
                          Content="Não abrir isto quando o Moductus iniciar"
                          VerticalAlignment="Center"
                          Click="OnNaoMostrarClick" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource inset.24}" Grid.IsSharedSizeScope="True">

                <TextBlock Text="Tudo a uma tecla de distância" Style="{DynamicResource style.title}" />
                <TextBlock Style="{DynamicResource style.secondary}" Margin="0,4,0,0"
                           Text="O Moductus não tem janela principal. Ele mora na bandeja e aparece quando você chama." />

                <TextBlock Text="Os três passos" Style="{StaticResource Secao}" />
                <Border Style="{StaticResource Cartao}">
                    <ItemsControl x:Name="Passos" ItemTemplate="{StaticResource LinhaPasso}" />
                </Border>

                <TextBlock Text="Se a tecla líder não responder" Style="{StaticResource Secao}" />
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="O Windows entrega uma hotkey global a um aplicativo só, e não avisa quem perdeu a disputa — o atalho simplesmente não funciona. Se outro programa já registrou a combinação, a tela de configurações mostra o conflito e o nome de quem está segurando." />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Enquanto isso, clique com o botão direito no ícone da bandeja: todo módulo ativo está lá, com os comandos de cada um em submenu." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Onde ver o que está ligado" Style="{StaticResource Secao}" />
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Estado que dura — microfone mudo, Awake ligado, pomodoro contando — aparece como pastilha no canto inferior direito. Clicar na pastilha desfaz, sem precisar do atalho de novo." />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="O ícone da bandeja também muda: o pomodoro desenha o progresso em volta dele e o microfone mudo ganha um risco. Se você não enxerga o ícone, ele está atrás da setinha de estouro do Windows — arraste-o para fora para fixar." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Os módulos" Style="{StaticResource Secao}" />
                <Border Style="{StaticResource Cartao}">
                    <ItemsControl x:Name="Modulos" ItemTemplate="{StaticResource LinhaPasso}" />
                </Border>

                <TextBlock Text="Privacidade" Style="{StaticResource Secao}" />
                <Border Style="{StaticResource Cartao}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Zero telemetria e zero rede: o aplicativo não faz nenhuma requisição HTTP, nem para checar atualização. O repositório é público desde o primeiro commit justamente porque um programa que registra hotkeys globais e lê o clipboard precisa ser auditável para merecer confiança." />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

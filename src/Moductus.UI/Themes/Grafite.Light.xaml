<!--
  Grafite — o padrão. Monocromático: o "accent" é a própria tinta, branca no
  escuro e preta no claro, e por isso o accent.fg inverte. Nenhuma cor compete
  com o conteúdo; quem dá o sinal é o contraste, não o matiz.
  Modo claro.

  Um tema declara SÓ cor, fonte, sombra e transparência; espaço, raio,
  tamanho e movimento são fixos e moram em Tokens.xaml. Nenhum pincel é
  escrito aqui: o Theme.cs transforma toda chave "X.color" no pincel
  congelado "X", e deriva os véus e os pincéis ajustáveis. Todo tema tem
  exatamente as mesmas chaves — faltando uma, o DynamicResource não resolve
  e o elemento some sem erro nenhum.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══ Tipografia ═══════════════════════════════════════════════════ -->
    <!-- Iguais em todos os temas por enquanto; o porquê de cada pilha está
         em Tokens.xaml. A chave mora aqui para que um tema possa variar. -->
    <FontFamily x:Key="font.ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="font.display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="font.mono">JetBrainsMono Nerd Font, JetBrainsMono NF, CaskaydiaCove Nerd Font, CaskaydiaCove NF, FiraCode Nerd Font, Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <!-- ═══ Cor ══════════════════════════════════════════════════════════ -->
    <Color x:Key="bg.base.color">#FAFAFA</Color>
    <Color x:Key="bg.raised.color">#FFFFFF</Color>
    <Color x:Key="bg.hover.color">#EBEBEB</Color>
    <Color x:Key="bg.inset.color">#F4F4F4</Color>
    <Color x:Key="border.subtle.color">#EAEAEA</Color>
    <!-- No mínimo 3:1 sobre bg.base: é a borda que separa o controle do fundo —
         botão, caixa de marcar, trilho do switch desligado — e sem ela o
         controle não se distingue do vazio. -->
    <Color x:Key="border.strong.color">#919191</Color>
    <Color x:Key="border.highlight.color">#CCFFFFFF</Color>
    <Color x:Key="text.primary.color">#171717</Color>
    <Color x:Key="text.secondary.color">#5C5C5C</Color>
    <Color x:Key="text.muted.color">#6E6E6E</Color>
    <Color x:Key="accent.color">#171717</Color>
    <Color x:Key="accent.fg.color">#FFFFFF</Color>
    <Color x:Key="accent.border.color">#171717</Color>
    <Color x:Key="accent.text.color">#000000</Color>
    <Color x:Key="success.color">#17804F</Color>
    <Color x:Key="danger.color">#D93B35</Color>
    <Color x:Key="shadow.color">#000000</Color>

    <!-- Tinta sobre o material do DWM. Só entra quando o Windows aceita
         pintar Mica ou Acrylic atrás da janela; se recusar, o fundo continua
         opaco, senão sobraria um retângulo preto com texto por cima. -->
    <Color x:Key="bg.base.tint.color">#C8FAFAFA</Color>
    <Color x:Key="bg.raised.tint.color">#D8FFFFFF</Color>

    <!-- ═══ Sombra ═══════════════════════════════════════════════════════ -->
    <!-- Elevação é borda de 1px em border.strong mais esta sombra. Nunca
         empilhar sombras. -->
    <sys:Double x:Key="shadow.blur">24</sys:Double>
    <sys:Double x:Key="shadow.depth">0</sys:Double>
    <sys:Double x:Key="shadow.opacity">0.10</sys:Double>

</ResourceDictionary>

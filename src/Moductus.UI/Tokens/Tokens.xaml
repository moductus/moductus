<!--
  FONTE ÚNICA de tamanho, tipografia, raio e movimento.
  Cor, fonte e sombra vivem nos temas (Themes/*.xaml, mais o
  Palette.HighContrast.xaml) e movimento em Motion.*.xaml, porque os dois são
  trocados em tempo de execução pelo Theme; o resto é fixo e mora aqui. Um
  tema escolhe cor, fonte, sombra e transparência — nunca espaço, raio,
  tamanho ou movimento, senão trocar de tema reorganizaria as telas.

  As chaves seguem os nomes da seção 6 do PRODUCT.md, para que o documento
  seja a referência. Nenhum literal visual fora destes arquivos.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══ Tipografia ═══════════════════════════════════════════════════ -->
    <!--
      font.ui, font.display e font.mono moram nos temas, para que um tema
      possa trocar de letra. Os valores são os mesmos em todos por enquanto, e
      o porquê de cada pilha fica escrito aqui, uma vez só:

      font.ui e font.display: Segoe UI Variable no Win11, Segoe UI no Win10.
      Zero download. O nome PRECISA trazer o sufixo óptico. "Segoe UI
      Variable" sozinho não é uma família instalada — as que existem são Text,
      Small e Display — e o WPF cai calado no Segoe UI do Windows 10. O app
      inteiro renderizava na fonte antiga por causa disso. Display tem sizing
      óptico próprio: só para título e número grande.

      font.mono: pilha de fontes de dev, da preferida para o que sempre
      existe. Nerd Font primeiro porque é o que quem vive em terminal já tem
      instalado, e o nome com "NF" e o sem sufixo cobrem as duas convenções de
      nomeação que os instaladores usam. Cascadia Code é o penúltimo degrau e
      vem no Windows 11 de fábrica; Consolas é o chão, presente desde o Vista.
      Nenhuma delas é embutida no pacote: uma Nerd Font sozinha passa de
      10 MB, e o app não baixa nada. Quem tem, vê; quem não tem, cai no degrau
      seguinte sem perceber.
    -->

    <!--
      Ícones. Segoe Fluent Icons vem no Windows 11 e Segoe MDL2 Assets no
      Windows 10, então o app tem ícone vetorial nos dois sem embutir arquivo
      nem adicionar dependência. Os glifos MDL2 que sobrevivem no Fluent têm o
      mesmo ponto de código, então a pilha funciona de verdade.
    -->
    <FontFamily x:Key="font.icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <FontWeight x:Key="weight.regular">Normal</FontWeight>
    <FontWeight x:Key="weight.semibold">SemiBold</FontWeight>

    <!-- Tamanho em DIP e line-height já resolvido (1.4 no corpo, 1.2 no título). -->
    <sys:Double x:Key="type.caption">11</sys:Double>
    <sys:Double x:Key="type.caption.line">15</sys:Double>
    <sys:Double x:Key="type.body">13</sys:Double>
    <sys:Double x:Key="type.body.line">18</sys:Double>
    <sys:Double x:Key="type.body-lg">15</sys:Double>
    <sys:Double x:Key="type.body-lg.line">21</sys:Double>
    <sys:Double x:Key="type.title">20</sys:Double>
    <sys:Double x:Key="type.title.line">24</sys:Double>
    <sys:Double x:Key="type.display">28</sys:Double>
    <!-- Fora da escala de propósito, e só aqui: o botão dentro da pastilha
         precisa ser menor que o corpo sem virar metadado. Com type.caption ele
         some ao lado do texto que acompanha; com type.body compete com ele. -->
    <sys:Double x:Key="type.action">12</sys:Double>
    <sys:Double x:Key="type.display.line">34</sys:Double>
    <!-- A letra dentro da keycap. Chave própria, embora valha o mesmo que
         caption: keycap é desenho de tecla, e se a legenda crescer a tecla não
         pode crescer junto. -->
    <sys:Double x:Key="type.keycap">11</sys:Double>
    <!-- Cabeçalho de seção em caixa-alta. Pequeno porque caixa-alta já pesa:
         no tamanho do corpo ele grita mais alto que o conteúdo que nomeia. -->
    <sys:Double x:Key="type.section">11</sys:Double>
    <sys:Double x:Key="type.section.line">15</sys:Double>
    <!-- O título na barra de título própria das janelas comuns: o tamanho da
         barra do Windows 11. Abaixo do corpo porque a barra rotula a janela,
         não compete com o cabeçalho que a tela já tem logo embaixo. -->
    <sys:Double x:Key="type.titlebar">12</sys:Double>
    <!-- Os glifos de minimizar, maximizar e fechar: 10, como os do sistema.
         Maior que isso o "✕" engorda e parece um botão de outro app. -->
    <sys:Double x:Key="type.caption.glyph">10</sys:Double>

    <!-- ═══ Espaço — grade de 4px ════════════════════════════════════════ -->
    <sys:Double x:Key="space.4">4</sys:Double>
    <sys:Double x:Key="space.8">8</sys:Double>
    <sys:Double x:Key="space.12">12</sys:Double>
    <sys:Double x:Key="space.16">16</sys:Double>
    <sys:Double x:Key="space.24">24</sys:Double>
    <sys:Double x:Key="space.32">32</sys:Double>

    <Thickness x:Key="inset.4">4</Thickness>
    <Thickness x:Key="inset.8">8</Thickness>
    <Thickness x:Key="inset.12">12</Thickness>
    <Thickness x:Key="inset.16">16</Thickness>
    <Thickness x:Key="inset.24">24</Thickness>
    <Thickness x:Key="inset.input">12,0</Thickness>
    <!-- O WPF reserva 2px de cada lado do texto de um campo para o cursor
         caber quando ele está na primeira ou na última posição. Esse recuo
         nasce dentro do content host e não dá para desligar: é a dica, que
         fica por fora dele, que precisa somá-lo ao recuo do campo para partir
         do mesmo ponto que o texto digitado. -->
    <Thickness x:Key="inset.caret">2,0</Thickness>
    <Thickness x:Key="inset.button">16,0</Thickness>
    <Thickness x:Key="inset.button.compact">12,0</Thickness>
    <!-- Linha de lista: o vão vertical é o que separa item de duas linhas do
         item seguinte. Zero aqui faz os dois colarem. -->
    <Thickness x:Key="inset.row">12,8</Thickness>
    <!-- Pastilha: o rótulo pequeno sobre fundo cheio, como as medidas do Freeze. -->
    <Thickness x:Key="inset.chip">6,2</Thickness>
    <!-- Cartão que flutua sobre conteúdo arbitrário — a lupa do Freeze, o alvo
         do Kill. Mais aperto na vertical que na horizontal, senão a caixa cresce
         mais que o texto que ela carrega. -->
    <Thickness x:Key="inset.card">10,5</Thickness>
    <!-- Só nas laterais: linha de lista que respira sem afastar da de cima. -->
    <Thickness x:Key="inset.8.h">8,0</Thickness>
    <!-- Rótulo de estado no rodapé — o "Salvo" do Scratch. Encostado no canto
         de baixo à direita, com menos folga embaixo que dos lados: com a folga
         da linha de lista ele descola do canto e parece um item solto. -->
    <Thickness x:Key="inset.status">0,0,12,6</Thickness>
    <!-- Recuos de um lado só. O nome diz a borda: start é a esquerda, end a
         direita, y é em cima e embaixo. Servem para afastar vizinhos numa
         linha sem empurrar a linha inteira. -->
    <Thickness x:Key="inset.start.8">8,0,0,0</Thickness>
    <Thickness x:Key="inset.start.12">12,0,0,0</Thickness>
    <Thickness x:Key="inset.start.16">16,0,0,0</Thickness>
    <Thickness x:Key="inset.end.8">0,0,8,0</Thickness>
    <Thickness x:Key="inset.end.12">0,0,12,0</Thickness>
    <Thickness x:Key="inset.top.8">0,8,0,0</Thickness>
    <Thickness x:Key="inset.bottom.8">0,0,0,8</Thickness>
    <Thickness x:Key="inset.y.4">0,4</Thickness>
    <Thickness x:Key="inset.y.16">0,16</Thickness>

    <!-- Pílula do HUD. À esquerda está o quadrado do ícone, e a folga dele é a
         mesma de cima e de baixo, para o quadrado ficar encaixado no canto da
         pílula; à direita é texto e ponto, que pedem mais ar. -->
    <Thickness x:Key="inset.pill">8,8,16,8</Thickness>
    <!-- Pastilha de estado: o mesmo encaixe do ícone. A folga da direita é
         maior também porque é o lado que encosta na borda da tela. -->
    <Thickness x:Key="inset.badge">8,8,16,8</Thickness>
    <!-- O botão dentro da pastilha, que tem altura própria e não precisa de
         folga vertical nenhuma. -->
    <Thickness x:Key="inset.badge.action">10,0</Thickness>
    <!-- A lista da Palette: encostada no campo de busca em cima, afastada das
         outras três bordas. -->
    <Thickness x:Key="inset.list">8,0,8,8</Thickness>
    <!-- Detalhe embaixo de um título, no cartão: colado nele em cima, afastado
         do que vem depois. -->
    <Thickness x:Key="inset.detail">0,4,0,12</Thickness>
    <!-- Rodapé e nota de um painel de formulário: alinhados ao recuo lateral do
         conteúdo, com a folga só do lado que encosta no resto. -->
    <Thickness x:Key="inset.field.status">12,0,12,8</Thickness>
    <Thickness x:Key="inset.field.note">12,8,12,0</Thickness>
    <!-- Legenda sob uma imagem — o texto do QR. -->
    <Thickness x:Key="inset.legend">16,0,16,12</Thickness>

    <!-- O overlay da tecla líder em três faixas — cabeçalho, grade, rodapé —
         separadas por divisor de ponta a ponta. Por isso a folga mora em cada
         faixa, e não num recuo do corpo inteiro: com recuo o divisor não
         chegaria às bordas. A grade tem 4 a menos que as outras porque cada
         bloco carrega 4 de margem (inset.4), e os blocos de fora alinham com
         o texto do cabeçalho. -->
    <Thickness x:Key="inset.leader.header">16,12</Thickness>
    <Thickness x:Key="inset.leader.grid">12</Thickness>
    <Thickness x:Key="inset.leader.footer">16,8</Thickness>
    <!-- Dentro do bloco: menos folga nos lados que em cima, porque o bloco é
         estreito e o nome embaixo da tecla precisa da largura. -->
    <Thickness x:Key="inset.leader.tile">8,12</Thickness>
    <!-- Afastamento entre a tecla desenhada e o nome do módulo, no overlay. -->
    <Thickness x:Key="inset.keycap">0,0,10,0</Thickness>
    <!-- Folga da letra dentro da keycap. Só nas laterais: a altura é a da
         tecla, e "Ctrl" precisa de ar dos lados para não encostar no degrau. -->
    <Thickness x:Key="inset.keycap.text">6,0</Thickness>
    <Thickness x:Key="inset.keycap.lg">8,0</Thickness>
    <!-- Chip de estado em pílula — "Desligado", "Ouvindo tecla…". Mais largo
         que o inset.chip das medidas do Freeze, porque aqui o texto é palavra
         e não número, e a pílula estreita demais vira cápsula de remédio. -->
    <Thickness x:Key="inset.chip.status">8,2</Thickness>
    <!-- Item da barra lateral das configurações: o texto alinha com o recuo
         da linha de lista, para a barra e a lista parecerem a mesma régua. -->
    <Thickness x:Key="inset.nav">12,0</Thickness>
    <!-- A barra de seleção não encosta em cima nem embaixo da linha: a linha
         tem canto arredondado, e a barra da altura toda vazaria pela curva. -->
    <Thickness x:Key="inset.selection.bar">0,8</Thickness>
    <!-- Vão entre o polegar e a borda do trilho do switch: (20 - 14) / 2. -->
    <Thickness x:Key="inset.switch.thumb">3</Thickness>
    <!-- O anel de foco desenhado POR FORA do controle, onde o preenchimento é
         da mesma cor do anel — o botão primário no Grafite, o switch ligado.
         Ali a borda em accent.border não se distingue do fundo, e o foco de
         teclado sumiria. -->
    <Thickness x:Key="inset.focus.ring">-3</Thickness>
    <!-- Janela principal. O cabeçalho (título e busca) não rola junto com a
         grade, então os dois blocos têm recuo próprio; a grade recua 8 a menos
         dos lados porque cada cartão já traz inset.8 de margem, e é a soma que
         alinha a borda dos cartões com a do campo de busca. -->
    <Thickness x:Key="inset.home.header">24,24,24,16</Thickness>
    <Thickness x:Key="inset.home.grid">16,0,16,16</Thickness>
    <!-- O campo de busca da janela principal tem a lupa à esquerda e a keycap
         "/" à direita, desenhadas por cima dele: o texto (e a dica) começa
         depois da lupa e para antes da keycap, senão passa por baixo delas. -->
    <Thickness x:Key="inset.home.search">36,0,40,0</Thickness>
    <Thickness x:Key="inset.home.search.top">0,16,0,0</Thickness>
    <!-- Rodapé da janela principal e da ajuda: baixo na vertical, mas com o
         mesmo recuo lateral do conteúdo, para o primeiro botão alinhar com a
         borda dos cartões. -->
    <Thickness x:Key="inset.home.footer">24,12</Thickness>
    <!-- Vão entre keycaps vizinhas ("Ctrl" "Alt" "M"), à direita de cada
         uma: menor que o vão entre palavras, para a combinação ler como um
         objeto só. Também na ajuda, onde as teclas são as mesmas. -->
    <Thickness x:Key="inset.home.keycap">0,0,4,0</Thickness>
    <!-- O divisor do cartão, entre a descrição e as ações: o vão fica só
         embaixo, porque em cima quem afasta é o inset.detail da descrição. Na
         ajuda, o mesmo vão separa um passo do seguinte. -->
    <Thickness x:Key="inset.home.divider">0,0,0,12</Thickness>
    <!-- Cabeçalho de seção da ajuda: longe do cartão de cima, perto do seu. -->
    <Thickness x:Key="inset.help.section">0,24,0,8</Thickness>
    <!-- A barra de ferramentas e a dica da Canvas, centradas no topo e no pé
         da tela. Afastadas da borda o bastante para não se confundirem com a
         barra de título da janela congelada por baixo nem com a de tarefas. -->
    <Thickness x:Key="inset.canvas.toolbar">0,16,0,0</Thickness>
    <Thickness x:Key="inset.canvas.hint">0,0,0,24</Thickness>
    <!-- O divisor vertical entre os grupos da barra da Canvas: mais curto que
         a barra, senão encosta nas bordas dela e parte a barra em caixas. -->
    <Thickness x:Key="inset.toolbar.divider">4,8</Thickness>
    <!-- Entre as keycaps de um atalho e entre a última e o que ele faz, na
         barra da Canvas: "Ctrl S salvar" lê como uma coisa só, não três. -->
    <Thickness x:Key="inset.canvas.keycap">0,0,4,0</Thickness>
    <!-- Barra de título e rodapé do Panel: o recuo do texto de uma linha de
         tabela do painel (8 da linha até a borda, mais 8 dentro dela), para a
         keycap da barra, a porta da primeira coluna e o texto do rodapé
         caírem na mesma régua. Sem folga vertical: a altura é da barra. -->
    <Thickness x:Key="inset.panel.bar">16,0</Thickness>
    <!-- O rodapé do Panel: a régua da barra, mais um respiro vertical para a
         dica que quebra em duas linhas no Shelf estreito não encostar nos
         filetes. Em uma linha só, quem manda na altura é o size.row. -->
    <Thickness x:Key="inset.panel.footer">16,4</Thickness>
    <!-- Entre dois botões de ícone vizinhos, o fixar e o fechar da barra do
         Panel. Com 8 eles pareciam dois grupos; colados, um alvo só. -->
    <Thickness x:Key="inset.start.4">4,0,0,0</Thickness>
    <!-- Entre colunas de uma tabela do Panel — pid, endereço, ação no Ports.
         Mais que o vão da keycap, para números de colunas vizinhas não lerem
         como um número só. -->
    <Thickness x:Key="inset.column">12,0,0,0</Thickness>

    <!-- A Palette. Chaves com o nome dela porque os números são da geometria
         dela: a linha com ícone, o campo com lupa, o rodapé de dicas. -->
    <!-- Em volta do campo de busca: a mesma folga dos lados, menos embaixo,
         porque o cabeçalho da primeira seção já traz a dele. -->
    <Thickness x:Key="inset.palette.header">12,12,12,4</Thickness>
    <!-- O texto do campo começa depois da lupa: 12 até ela, 16 dela, 8 de ar.
         A direita é só o mínimo; o chip do tipo empurra quando aparece. -->
    <Thickness x:Key="inset.palette.input">36,0,12,0</Thickness>
    <!-- A linha com o quadrado do ícone: 6 + 24 + 6 fecham os 36 do size.row.
         Com o inset.row comum, o quadrado esticava a linha para 40. -->
    <Thickness x:Key="inset.palette.row">12,6</Thickness>
    <!-- Cabeçalho de seção: alinhado ao quadrado do ícone, mais ar em cima —
         é ele que separa um grupo do outro — que embaixo. -->
    <Thickness x:Key="inset.palette.section">12,8,12,4</Thickness>
    <!-- O rodapé das dicas de teclado e da contagem. -->
    <Thickness x:Key="inset.palette.footer">12,8</Thickness>
    <!-- Entre duas keycaps de uma combinação (↑ ↓, Ctrl Shift C): perto o
         bastante para lerem como uma coisa só. -->
    <Thickness x:Key="inset.palette.keycap.gap">4,0,0,0</Thickness>
    <!-- Configurações. Vão entre um grupo e o seguinte dentro de uma seção:
         maior que o vão entre linhas, para o olho separar "Tema" de "Modo"
         sem precisar de divisor. -->
    <Thickness x:Key="inset.settings.group">0,0,0,24</Thickness>
    <!-- O rodapé de dicas: baixo, como uma barra de status, e alinhado ao
         recuo do conteúdo. -->
    <Thickness x:Key="inset.settings.footer">16,8</Thickness>
    <!-- Entre duas keycaps da mesma combinação: perto o bastante para
         "Ctrl Alt M" ler como uma coisa só. -->
    <Thickness x:Key="inset.settings.keycap">0,0,4,0</Thickness>
    <!-- A grade de temas: cada cartão leva 4px em volta, e a grade recua os
         mesmos 4px para fora, senão a primeira coluna sai desalinhada do
         texto da seção. -->
    <Thickness x:Key="inset.settings.theme.grid">-4</Thickness>

    <!-- ═══ Raio ═════════════════════════════════════════════════════════ -->
    <!-- O Win11 usa 8 em menu e 12 em janela; isto encaixa sem parecer
         estrangeiro. O cartão acompanha o menu: com 10 ele ficava mais redondo
         que a janela de 8 que o contém na pastilha, e parecia solto. -->
    <CornerRadius x:Key="radius.control">6</CornerRadius>
    <CornerRadius x:Key="radius.card">8</CornerRadius>
    <CornerRadius x:Key="radius.window">12</CornerRadius>
    <CornerRadius x:Key="radius.pill">999</CornerRadius>
    <!-- O WPF não faz cápsula com raio gigante como o CSS: CornerRadius maior
         que metade da altura vira ELIPSE, e o trilho do switch saía com cara
         de ovo. Cápsula de verdade é raio exatamente igual a metade da altura,
         então cada uma tem a sua chave, amarrada ao tamanho que ela tem. -->
    <CornerRadius x:Key="radius.switch">10</CornerRadius>
    <!-- O anel de foco do switch passa 3px para fora em cada lado (inset.focus.ring). -->
    <CornerRadius x:Key="radius.switch.ring">13</CornerRadius>
    <!-- Igual ao do controle hoje, chave própria: a keycap é desenho de tecla,
         e mexer no raio dos botões não pode amolecer as teclas junto. -->
    <CornerRadius x:Key="radius.keycap">6</CornerRadius>
    <!-- O anel de foco por fora: o raio do controle mais o afastamento do
         inset.focus.ring, senão as duas curvas não ficam concêntricas e o anel
         engrossa nos cantos. -->
    <CornerRadius x:Key="radius.focus">9</CornerRadius>
    <!-- O recorte que o DWM faz no HWND (DWMWCP_ROUND). Não é escolha nossa: o
         sistema arredonda em 8 e não aceita outro valor. Toda superfície que
         encosta na borda da janela — a pastilha e a pílula do HUD — usa
         exatamente este raio, senão sobra uma lasca do fundo da janela entre a
         curva do Border e o corte do sistema. Não é radius.card de propósito:
         o cartão de dentro é desenho nosso, este raio é do Windows. -->
    <CornerRadius x:Key="radius.clip">8</CornerRadius>
    <!-- Sem recorte nativo — Windows 10, ou build do 11 anterior ao 22000 — o
         HWND é um retângulo vivo e a superfície acompanha: cartão de cantos
         vivos, opaco e legível, que se passa por desenho nativo daquele
         Windows em vez de moldura vazando nos quatro cantos. -->
    <CornerRadius x:Key="radius.clip.none">0</CornerRadius>
    <!-- A miniatura do cartão de tema: as linhas de texto têm 4px de altura
         e a amostra do destaque 8, e cada raio é exatamente a metade — maior
         que isso o WPF desenha elipse, não cápsula. -->
    <CornerRadius x:Key="radius.theme.line">2</CornerRadius>
    <CornerRadius x:Key="radius.theme.accent">4</CornerRadius>
    <!-- O polegar da barra de rolagem, em repouso e com o mouse na barra.
         Cápsula de verdade: exatamente metade de size.scroll.thumb e de
         size.scroll.thumb.hover — o radius.pill de 999 virava elipse, como
         o trilho do switch antes do radius.switch. -->
    <CornerRadius x:Key="radius.scroll.thumb">2</CornerRadius>
    <CornerRadius x:Key="radius.scroll.thumb.hover">4</CornerRadius>

    <!-- ═══ Tamanho ══════════════════════════════════════════════════════ -->
    <!-- Linha e campo em 36: com o ícone em quadrado e a keycap à direita, 32
         apertava os dois contra as bordas da linha. O botão fica em 32 — ao
         lado de um campo ele é ação, não campo, e não precisa da mesma altura. -->
    <sys:Double x:Key="size.row">36</sys:Double>
    <sys:Double x:Key="size.input">36</sys:Double>
    <!-- O campo de busca da Palette e da janela principal: é o elemento que a
         tela inteira serve, e merece ser o maior campo dela. -->
    <sys:Double x:Key="size.input.search">40</sys:Double>
    <sys:Double x:Key="size.button">32</sys:Double>
    <!-- Botão dentro de barra ou linha de lista. Precisa ser MENOR que a faixa
         que o contém, senão encosta nas duas bordas e fica achatado. -->
    <sys:Double x:Key="size.button.compact">28</sys:Double>
    <!-- Botão só de ícone: quadrado, para o glifo não virar um retângulo. -->
    <sys:Double x:Key="size.button.icon">28</sys:Double>
    <!-- A barra de título do Panel. 44 dá 8px de folga em cima e embaixo do
         botão compacto; com 32 o botão preenchia a barra inteira. -->
    <sys:Double x:Key="size.titlebar">44</sys:Double>
    <sys:Double x:Key="size.icon">16</sys:Double>
    <!-- Painel de configuração: a coluna do rótulo e a caixa de número. A
         coluna cabe o rótulo mais longo dos doze módulos, e é a mesma em todos
         para que dois painéis abertos um depois do outro não pareçam telas de
         apps diferentes. A caixa é estreita de propósito: o que se digita ali
         são minutos, segundos ou itens, nunca um texto. -->
    <sys:Double x:Key="size.settings.label">128</sys:Double>
    <sys:Double x:Key="size.settings.field">80</sys:Double>
    <!-- Campo de texto curto no painel: sufixo, nome. Não é caminho de arquivo,
         que estica. -->
    <sys:Double x:Key="size.settings.text">160</sys:Double>

    <!-- Ponto de estado antes do texto, no HUD e na pastilha. Menor que o
         ícone inline: é sinal, não desenho. -->
    <sys:Double x:Key="size.dot">8</sys:Double>
    <!-- Amostra de cor do conta-gotas, ao lado do valor hexadecimal. -->
    <sys:Double x:Key="size.swatch">14</sys:Double>
    <!-- A coluna da porta na lista do Ports. Fixa para os números ficarem
         alinhados entre linhas; cabe cinco dígitos. -->
    <sys:Double x:Key="size.port">64</sys:Double>
    <!-- Zona de soltar arquivo: alta o bastante para ser alvo de arrasto sem
         tomar o painel. -->
    <sys:Double x:Key="size.dropzone">72</sys:Double>
    <!-- Teto do cartão sobre a Canvas. Sem ele, uma janela de título comprido
         esticaria o cartão de ponta a ponta da tela. -->
    <sys:Double x:Key="size.card.maxwidth">520</sys:Double>
    <!-- Teto e altura de ação da pastilha. Ela mora no canto e precisa caber
         lá sem virar painel. -->
    <sys:Double x:Key="size.badge.maxwidth">320</sys:Double>
    <sys:Double x:Key="size.badge.action">24</sys:Double>
    <sys:Double x:Key="size.palette.width">640</sys:Double>
    <sys:Double x:Key="size.palette.maxheight">480</sys:Double>
    <sys:Double x:Key="size.panel.minwidth">320</sys:Double>
    <sys:Double x:Key="size.panel.minheight">240</sys:Double>
    <!-- Onde o Panel nasce quando é a primeira vez. Depois disso ele fica onde
         o usuário deixou, então estes valores só valem para a primeira
         impressão: largos o bastante para uma lista de portas caber sem
         redimensionar, estreitos o bastante para não parecerem uma janela de
         aplicativo. -->
    <sys:Double x:Key="size.panel.width">560</sys:Double>
    <sys:Double x:Key="size.panel.height">360</sys:Double>
    <!-- Na borda, ele é alto e estreito como uma bandeja: a largura mínima, e
         a fração da altura útil do monitor, que acompanha a tela em vez de
         fixar um número que sobra em 4K e falta em notebook. -->
    <sys:Double x:Key="size.panel.edge.height">0.6</sys:Double>
    <!-- Largura do bloco do overlay da líder: keycap grande em cima, nome
         embaixo. Cabe o nome de módulo mais longo em type.caption sem quebrar. -->
    <sys:Double x:Key="size.leader.tile">96</sys:Double>
    <!-- Colunas da grade do overlay: doze módulos viram 4×3, que cabe no
         campo de visão sem varrer a tela de lado a lado. A janela segue a
         grade, não o contrário — a largura dela sai daqui. -->
    <sys:Int32 x:Key="size.leader.columns">4</sys:Int32>

    <!-- Keycap: o desenho de uma tecla. O tamanho é MÍNIMO, nos dois eixos —
         "M" fica quadrada, "Ctrl" cresce para os lados. A grande é a do
         overlay da líder e a do cartão da janela principal. -->
    <sys:Double x:Key="size.keycap">20</sys:Double>
    <sys:Double x:Key="size.keycap.lg">28</sys:Double>

    <!-- Switch de ligar e desligar. Proporção do Windows 11 em escala menor:
         o app é denso, e o switch do sistema (40×20) disputava espaço com o
         nome do módulo no cartão. -->
    <sys:Double x:Key="size.switch.width">36</sys:Double>
    <sys:Double x:Key="size.switch.height">20</sys:Double>
    <sys:Double x:Key="size.switch.thumb">14</sys:Double>

    <!-- A barra à esquerda da linha selecionada e do item marcado da barra
         lateral. Ela, e não o preenchimento, é o sinal de seleção: preencher a
         linha com accent no Grafite viraria uma faixa branca. -->
    <sys:Double x:Key="size.selection.bar">2</sys:Double>
    <!-- Barra lateral das configurações: cabe "Atalhos globais" com folga. -->
    <sys:Double x:Key="size.nav.width">200</sys:Double>
    <!-- Largura mínima de uma célula da grade da janela principal, margem do
         cartão incluída. Menor que size.panel.minwidth, que era o que valia
         antes: com ele a janela precisava de mais de mil pixels para três
         colunas, e a grade de doze módulos virava seis linhas de rolagem. -->
    <sys:Double x:Key="size.home.card">280</sys:Double>
    <!-- O quadrado do ícone no HUD e na pastilha. Do tamanho das duas linhas
         de texto ao lado, título e detalhe: menor, o ícone vira enfeite solto;
         maior, a pílula engorda só por causa dele. -->
    <sys:Double x:Key="size.status.icon">32</sys:Double>
    <!-- O quadrado do ícone na linha da Palette. Diz o tipo do resultado antes
         de se ler o nome; maior que isto não cabe nos 36 da linha. -->
    <sys:Double x:Key="size.palette.icon">24</sys:Double>
    <!-- A janela de configurações. Larga o bastante para a barra lateral e
         três cartões de tema lado a lado; o mínimo ainda cabe a barra e uma
         linha de módulo com a letra e o "Ajustar" sem quebrar. -->
    <sys:Double x:Key="size.settings.width">880</sys:Double>
    <sys:Double x:Key="size.settings.height">640</sys:Double>
    <sys:Double x:Key="size.settings.minwidth">720</sys:Double>
    <sys:Double x:Key="size.settings.minheight">480</sys:Double>
    <!-- Teto da coluna de conteúdo: com a janela maximizada, a descrição de
         um módulo corria a tela inteira e o "Ajustar" ia parar longe do nome. -->
    <sys:Double x:Key="size.settings.content">720</sys:Double>
    <!-- A janela do ajuste de um módulo: estreita, porque o painel é uma
         coluna de rótulo e campo, e com altura que acompanha o conteúdo até
         um teto — o painel mais longo rola em vez de passar da tela. -->
    <sys:Double x:Key="size.settings.module.width">460</sys:Double>
    <sys:Double x:Key="size.settings.module.minheight">200</sys:Double>
    <sys:Double x:Key="size.settings.module.maxheight">720</sys:Double>
    <!-- A miniatura de cada tema no cartão de escolha: cabe o fundo, um
         cartão com duas linhas de texto e a cor de destaque. -->
    <sys:Double x:Key="size.theme.preview">64</sys:Double>

    <!-- Prazo do overlay da tecla líder antes de devolver o foco sozinho. Não é
         animação, é tempo de leitura: nove segundos é o que mede varrer a grade
         dos doze módulos sem ter as letras decoradas. Por isso mora aqui e não
         em Motion.*.xaml — ler não depende de o usuário ter desligado efeitos,
         e com o dicionário reduzido a chave iria a zero e o overlay sumiria
         antes de aparecer. -->
    <Duration x:Key="motion.leader.timeout">0:0:9</Duration>

    <!-- Elevação é só isto: borda de 1px em border.strong mais uma sombra suave.
         Nunca empilhar sombras. -->
    <Thickness x:Key="border.width">1</Thickness>
    <!-- Moldura que precisa se impor sobre conteúdo arbitrário: a lupa do Freeze
         sobre a tela congelada, o cartão do Kill sobre a janela alvo. -->
    <Thickness x:Key="border.width.strong">2</Thickness>
    <!-- A faixa invisível onde o cursor vira seta de redimensionar, no Panel.
         Não é borda desenhada: é alvo de mouse, e 1px é impossível de acertar. -->
    <Thickness x:Key="border.resize">6</Thickness>
    <!-- O "degrau" da keycap: a borda de baixo mais grossa é o que faz o
         retângulo ler como tecla, e não como mais um chip. -->
    <Thickness x:Key="border.width.keycap">1,1,1,2</Thickness>
    <!-- Só em cima: o brilho de 1px em border.highlight no topo interno da
         superfície flutuante, o "stroke" do Fluent. -->
    <Thickness x:Key="border.width.top">0,1,0,0</Thickness>
    <!-- Só à direita: o divisor entre a barra lateral das configurações e o
         conteúdo. -->
    <Thickness x:Key="border.width.nav">0,0,1,0</Thickness>
    <!-- shadow.blur, shadow.depth e shadow.opacity moram nos temas: a sombra
         que funciona sobre fundo grafite some sobre fundo claro. -->
    <!-- Só à esquerda: o divisor vertical entre grupos da barra da Canvas. -->
    <Thickness x:Key="border.width.start">1,0,0,0</Thickness>
    <!-- A seleção do Freeze: traço fino e tracejado, para a borda marcar o
         recorte sem tampar o pixel da beira, que também vai para o clipboard.
         O tracejado é em múltiplos da espessura, como todo StrokeDashArray. -->
    <sys:Double x:Key="stroke.selection">1</sys:Double>
    <DoubleCollection x:Key="dash.selection">4 3</DoubleCollection>
    <!-- Só embaixo: o filete que separa a barra de título do Panel do
         conteúdo, e o cabeçalho de colunas das linhas. O rodapé usa o
         border.width.top, do lado oposto. -->
    <Thickness x:Key="border.width.bottom">0,0,0,1</Thickness>
    <!-- Barra de título própria das janelas comuns (a altura é a
         size.titlebar, a mesma do Panel). O botão tem a largura dos botões
         do Windows 11: quem já sabe onde o "fechar" mora acerta o nosso. -->
    <sys:Double x:Key="size.caption.button">46</sys:Double>
    <!-- O mark na barra de título: o tamanho do ícone de janela do sistema. -->
    <sys:Double x:Key="size.mark">16</sys:Double>
    <!-- O mark do Moductus a 16px, em vetor: os quatro módulos 2×2 da redução
         que a bandeja usa (Mark.Render no tamanho 16 — margem 1, módulo 6,
         vão 2, canto 1). Vetor, e não o bitmap da bandeja, porque o bitmap
         segue a cor da barra de tarefas e borra fora de 100% de escala; aqui
         ele pega a cor do tema e fica nítido em qualquer DPI. -->
    <GeometryGroup x:Key="geometry.mark">
        <RectangleGeometry Rect="1,1,6,6" RadiusX="1" RadiusY="1" />
        <RectangleGeometry Rect="9,1,6,6" RadiusX="1" RadiusY="1" />
        <RectangleGeometry Rect="1,9,6,6" RadiusX="1" RadiusY="1" />
        <RectangleGeometry Rect="9,9,6,6" RadiusX="1" RadiusY="1" />
    </GeometryGroup>
    <!-- Barra de rolagem: a faixa que ela ocupa ao lado do conteúdo e a
         espessura do polegar, fino em repouso e mais grosso com o mouse na
         barra. A faixa tem folga dos dois lados do polegar grosso, senão ele
         encosta no conteúdo e na borda da janela. -->
    <sys:Double x:Key="size.scroll">12</sys:Double>
    <sys:Double x:Key="size.scroll.thumb">4</sys:Double>
    <sys:Double x:Key="size.scroll.thumb.hover">8</sys:Double>

    <!-- ═══ Véus e opacidade ═════════════════════════════════════════════ -->
    <!-- Quanto da cor cheia vai nos véus que o Theme deriva de cada tema:
         accent.veil no miolo de seleção, success.veil e danger.veil no fundo
         dos chips e da caixa de erro. Os semânticos são um pouco mais leves
         porque o verde e o vermelho saturam mais que o accent na mesma dose. -->
    <sys:Double x:Key="veil.accent.opacity">0.16</sys:Double>
    <sys:Double x:Key="veil.semantic.opacity">0.14</sys:Double>
    <!-- O véu do Canvas: escurece o desktop congelado para a anotação do
         Freeze e o alvo do Kill se destacarem. Preto em todo tema e modo,
         porque quem escurece não pode clarear no tema claro — e por isso mora
         aqui e não nos temas. A opacidade mora no pincel para que o retângulo
         não carregue número nenhum. -->
    <SolidColorBrush x:Key="veil.canvas" Color="Black" Opacity="0.40" />
    <!-- Hover do botão de preenchimento cheio (primário): o fundo dilui um
         pouco sobre o que está atrás. Funciona em qualquer accent, claro ou
         escuro, sem um token de "accent.hover" por tema. -->
    <sys:Double x:Key="opacity.hover.solid">0.88</sys:Double>
    <!-- O que está desligado, mas continua ali: o módulo desativado no cartão
         e no overlay da líder. Atenuado, não escondido — e nunca em vermelho,
         porque desligado não é perigo. -->
    <sys:Double x:Key="opacity.disabled">0.45</sys:Double>

    <!-- ═══ Curvas ═══════════════════════════════════════════════════════ -->
    <!-- Sem mola, sem bounce. -->
    <CubicEase x:Key="ease.out" EasingMode="EaseOut" />
    <CubicEase x:Key="ease.in" EasingMode="EaseIn" />

</ResourceDictionary>

<!--
  Movimento. Nada acima de 200ms em lugar nenhum; deslocamento máximo de 8px;
  escala partindo de 0.98. A hotkey é o produto: se a estética custar o
  orçamento de 140ms, a estética cede.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Duration x:Key="motion.enter">0:0:0.140</Duration>
    <Duration x:Key="motion.exit">0:0:0.090</Duration>
    <Duration x:Key="motion.hover">0:0:0.080</Duration>

    <!-- O pisca da letra desconhecida no overlay da tecla líder. Não é
         transição: é a resposta a um erro de digitação, e sem ela a tecla
         errada não devolve sinal nenhum. Por isso tem chave própria e vale
         o mesmo com animações desligadas. -->
    <Duration x:Key="motion.blink">0:0:0.140</Duration>

    <sys:Double x:Key="motion.offset">8</sys:Double>
    <sys:Double x:Key="motion.scale">0.98</sys:Double>

    <sys:Boolean x:Key="motion.enabled">True</sys:Boolean>

</ResourceDictionary>

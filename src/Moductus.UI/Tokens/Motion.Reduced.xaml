<!--
  O usuário desligou animações na acessibilidade do Windows
  (SPI_GETCLIENTAREAANIMATION). Tudo vai a zero — mesmas chaves, para que o
  código que anima não precise saber.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Duration x:Key="motion.enter">0:0:0</Duration>
    <Duration x:Key="motion.exit">0:0:0</Duration>
    <Duration x:Key="motion.hover">0:0:0</Duration>

    <sys:Double x:Key="motion.offset">0</sys:Double>
    <sys:Double x:Key="motion.scale">1</sys:Double>

    <sys:Boolean x:Key="motion.enabled">False</sys:Boolean>

</ResourceDictionary>

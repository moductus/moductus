<!--
  Estilos implícitos dos controles básicos, todos em cima dos tokens.
  É isto que faz uma janela sem nenhum estilo local já parecer do Moductus.

  ARMADILHA: estilo implícito só casa com o tipo EXATO, nunca com subclasse.
  Toda janela nossa é subclasse de Window, então cada uma precisa declarar
  Style="{DynamicResource {x:Type Window}}" explicitamente — sem isso ela
  nasce branca com texto claro. Os arquétipos fazem isso no construtor base.

  Foco de teclado é mostrado pela borda em accent de cada controle; o
  retângulo pontilhado padrão do WPF fica desligado.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource bg.base}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="LineHeight" Value="{DynamicResource type.body.line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="style.caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource type.caption}" />
        <Setter Property="LineHeight" Value="{DynamicResource type.caption.line}" />
        <Setter Property="Foreground" Value="{DynamicResource text.secondary}" />
    </Style>

    <Style x:Key="style.title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource font.display}" />
        <Setter Property="FontSize" Value="{DynamicResource type.title}" />
        <Setter Property="LineHeight" Value="{DynamicResource type.title.line}" />
        <Setter Property="FontWeight" Value="{DynamicResource weight.semibold}" />
    </Style>

    <Style x:Key="style.secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource text.secondary}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="{DynamicResource size.button}" />
        <Setter Property="Padding" Value="{DynamicResource inset.button}" />
        <Setter Property="Background" Value="{DynamicResource bg.raised}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource accent.border}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource text.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton deriva de ButtonBase, não de Button: não dá para BasedOn.
         Estilo próprio, com IsChecked em accent. -->
    <Style TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="{DynamicResource size.button}" />
        <Setter Property="Padding" Value="{DynamicResource inset.button}" />
        <Setter Property="Background" Value="{DynamicResource bg.raised}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource accent}" />
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource accent.fg}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource accent.border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource size.input}" />
        <Setter Property="Padding" Value="{DynamicResource inset.input}" />
        <Setter Property="Background" Value="{DynamicResource bg.raised}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body-lg}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Dica: campo vazio sem rótulo parece campo quebrado,
                                 porque o cursor fica sozinho no meio do nada. Vem
                                 do Tag para não exigir controle nem anexada. -->
                            <TextBlock x:Name="Dica"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource text.muted}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Dica" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource accent.border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="MinHeight" Value="{DynamicResource size.row}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Caixa"
                                Width="{DynamicResource size.icon}"
                                Height="{DynamicResource size.icon}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource bg.raised}"
                                BorderBrush="{DynamicResource border.strong}"
                                BorderThickness="{DynamicResource border.width}"
                                CornerRadius="4">
                            <!-- A borda de 1px inseta o filho, então a origem do
                                 Path é (1,1), não (0,0). Desenhado para (0,0) o
                                 visto fica 1px baixo, 1px à direita, e a ponta
                                 encosta na borda da caixa. -->
                            <Path x:Name="Marca"
                                  Data="M 2.75,7 L 5.75,10 L 11.25,4"
                                  Stroke="{DynamicResource accent.fg}"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caixa" Property="Background" Value="{DynamicResource accent}" />
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource accent}" />
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Caixa" Property="BorderBrush" Value="{DynamicResource accent.border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Linha quebra; nunca rola na horizontal. -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Background" Value="{DynamicResource bg.raised}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
        <Setter Property="Padding" Value="{DynamicResource inset.4}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.card}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{DynamicResource size.row}" />
        <Setter Property="Padding" Value="{DynamicResource inset.row}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Linha"
                            Background="Transparent"
                            CornerRadius="{DynamicResource radius.control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Linha" Property="Background" Value="{DynamicResource bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Linha" Property="Background" Value="{DynamicResource accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource accent.fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource border.subtle}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ═══ Barra de rolagem ═════════════════════════════════════════════ -->
    <!--
      Sem isto o WPF entrega a barra do tema clássico do Windows: cinza,
      larga, com setas nas pontas. É a peça que mais denuncia janela feita às
      pressas, e aparece em toda lista do app.

      A barra daqui é um trilho invisível com um polegar que engorda no hover,
      como no Edge e no VS Code. Sem setas: ninguém clica em seta de rolagem
      desde que a roda do mouse existe, e elas custam 34px de altura útil.
    -->
    <Style x:Key="style.scroll.thumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- O Border externo é a área de clique; o interno é o que se vê. -->
                    <Border Background="Transparent" Padding="3">
                        <Border x:Name="Barra"
                                Background="{DynamicResource border.strong}"
                                CornerRadius="{DynamicResource radius.pill}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Barra" Property="Background" Value="{DynamicResource text.muted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Barra" Property="Background" Value="{DynamicResource text.secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O trilho precisa existir para o clique em página funcionar, e precisa
         ser invisível para não desenhar um bloco atrás do polegar. -->
    <Style x:Key="style.scroll.track" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource style.scroll.track}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource style.scroll.thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource style.scroll.track}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O quadradinho do canto entre as duas barras some junto. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Margin="{TemplateBinding Padding}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0" Grid.Column="1"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1" Grid.Column="0"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Menu de contexto ═════════════════════════════════════════════ -->
    <!--
      Sem isto o menu da bandeja sai no tema do sistema: fundo branco no meio
      de um app escuro. É a superfície permanente do produto, e era a única
      que não passava pelos tokens.
    -->
    <Style x:Key="style.menu.separator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource border.subtle}" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource bg.raised}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong}" />
        <Setter Property="BorderThickness" Value="{DynamicResource border.width}" />
        <Setter Property="Padding" Value="{DynamicResource inset.4}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource radius.card}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource text.primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource font.ui}" />
        <Setter Property="FontSize" Value="{DynamicResource type.body}" />
        <Setter Property="MinHeight" Value="{DynamicResource size.row}" />
        <Setter Property="Padding" Value="{DynamicResource inset.row}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Linha"
                            Background="Transparent"
                            CornerRadius="{DynamicResource radius.control}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />

                            <!-- A letra do lider vem aqui: usar o menu duas
                                 vezes ensina a tecla e dispensa o menu. -->
                            <TextBlock x:Name="Gesto"
                                       Grid.Column="1"
                                       Text="{TemplateBinding InputGestureText}"
                                       FontFamily="{DynamicResource font.mono}"
                                       Foreground="{DynamicResource text.muted}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0" />

                            <Path x:Name="Seta"
                                  Grid.Column="2"
                                  Data="M 0,0 L 4,4 L 0,8"
                                  Stroke="{DynamicResource text.secondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0"
                                  Visibility="Collapsed" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="4"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource bg.raised}"
                                        BorderBrush="{DynamicResource border.strong}"
                                        BorderThickness="{DynamicResource border.width}"
                                        CornerRadius="{DynamicResource radius.card}"
                                        Padding="{DynamicResource inset.4}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Seta" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Linha" Property="Background" Value="{DynamicResource bg.hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource text.muted}" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesto" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

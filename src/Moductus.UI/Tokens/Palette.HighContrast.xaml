<!--
  Alto contraste do Windows. Os tokens de cor deixam de ser nossos e passam a
  ser do sistema — usar a paleta própria aqui anularia a acessibilidade que o
  usuário ligou por necessidade. Por isso este arquivo não é tema nenhum: o
  tema escolhido nas configurações é ignorado enquanto o modo estiver ligado.

  São snapshots (x:Static). O Theme reaplica este dicionário a cada
  WM_SETTINGCHANGE, então uma troca de esquema de alto contraste é acompanhada.

  Mesmas chaves dos temas, sem exceção, e do mesmo jeito: só as cores. O
  Theme.cs transforma toda chave "X.color" no pincel "X" e deriva os véus,
  então o alto contraste ganha as chaves novas junto com os temas.
  Faltando uma, o DynamicResource não resolve, o elemento fica sem pincel e
  some — sem erro nenhum.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══ Tipografia ═══════════════════════════════════════════════════ -->
    <!-- As mesmas dos temas: alto contraste troca cor, não letra. -->
    <FontFamily x:Key="font.ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="font.display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="font.mono">JetBrainsMono Nerd Font, JetBrainsMono NF, CaskaydiaCove Nerd Font, CaskaydiaCove NF, FiraCode Nerd Font, Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <!-- ═══ Cor ══════════════════════════════════════════════════════════ -->
    <x:Static x:Key="bg.base.color" Member="SystemColors.WindowColor" />
    <x:Static x:Key="bg.raised.color" Member="SystemColors.ControlColor" />
    <x:Static x:Key="bg.hover.color" Member="SystemColors.HighlightColor" />
    <!-- Área rebaixada — campo de busca, keycap. Em alto contraste não há
         degrau de cinza que valha: é o fundo da janela, e quem separa a área
         do resto é a borda. -->
    <x:Static x:Key="bg.inset.color" Member="SystemColors.WindowColor" />
    <x:Static x:Key="border.subtle.color" Member="SystemColors.ActiveBorderColor" />
    <x:Static x:Key="border.strong.color" Member="SystemColors.WindowFrameColor" />
    <!-- O brilho de 1px no topo da superfície flutuante é enfeite de
         profundidade, e enfeite translúcido não tem lugar aqui. Na cor do
         fundo elevado ele simplesmente desaparece. -->
    <x:Static x:Key="border.highlight.color" Member="SystemColors.ControlColor" />
    <x:Static x:Key="text.primary.color" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="text.secondary.color" Member="SystemColors.GrayTextColor" />
    <x:Static x:Key="text.muted.color" Member="SystemColors.GrayTextColor" />
    <x:Static x:Key="accent.color" Member="SystemColors.HighlightColor" />
    <x:Static x:Key="accent.fg.color" Member="SystemColors.HighlightTextColor" />
    <!-- A moldura de foco de campo sai daqui. Faltando a chave, o DynamicResource
         não resolve e o foco fica invisível — sem erro nenhum. -->
    <x:Static x:Key="accent.border.color" Member="SystemColors.HighlightColor" />
    <!-- Destaque usado como TEXTO sobre o fundo da janela. Highlight é feito
         para ser fundo de seleção, não letra; a cor de link do esquema é a que
         o sistema garante legível sobre o fundo da janela. -->
    <x:Static x:Key="accent.text.color" Member="SystemColors.HotTrackColor" />
    <x:Static x:Key="success.color" Member="SystemColors.WindowTextColor" />
    <x:Static x:Key="danger.color" Member="SystemColors.WindowTextColor" />
    <Color x:Key="shadow.color">#000000</Color>

    <!-- Os dois "tint" são o fundo de quando o DWM aceita pintar material atrás
         da janela. Em alto contraste não há translucidez que valha: quem ligou
         o modo pediu contraste máximo, e fundo meio transparente sobre Acrylic
         apaga o texto. Por isso são opacos, iguais aos de cima. Precisam existir
         aqui de todo jeito — sem a chave o DynamicResource não resolve, o Border
         fica sem fundo nenhum e a superfície some, sem erro nenhum. -->
    <x:Static x:Key="bg.base.tint.color" Member="SystemColors.WindowColor" />
    <x:Static x:Key="bg.raised.tint.color" Member="SystemColors.ControlColor" />

    <!-- ═══ Sombra ═══════════════════════════════════════════════════════ -->
    <sys:Double x:Key="shadow.blur">24</sys:Double>
    <sys:Double x:Key="shadow.depth">0</sys:Double>
    <sys:Double x:Key="shadow.opacity">0.35</sys:Double>

</ResourceDictionary>

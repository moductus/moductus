<!--
  Alto contraste do Windows. Os tokens de cor deixam de ser nossos e passam a
  ser do sistema — usar a paleta própria aqui anularia a acessibilidade que o
  usuário ligou por necessidade.

  São snapshots (x:Static). O Theme reaplica este dicionário a cada
  WM_SETTINGCHANGE, então uma troca de esquema de alto contraste é acompanhada.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="bg.base" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="bg.raised" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="bg.hover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="border.subtle" Color="{x:Static SystemColors.ActiveBorderColor}" />
    <SolidColorBrush x:Key="border.strong" Color="{x:Static SystemColors.WindowFrameColor}" />
    <SolidColorBrush x:Key="text.primary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="text.secondary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="text.muted" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="accent" Color="{x:Static SystemColors.HighlightColor}" />
    <!-- A moldura de foco de campo sai daqui. Faltando a chave, o DynamicResource
         não resolve e o foco fica invisível — sem erro nenhum. -->
    <SolidColorBrush x:Key="accent.border" Color="{x:Static SystemColors.HighlightColor}" />
    <!-- Accent translúcido: o miolo de uma seleção, que precisa deixar ver o
         que está embaixo. Existe como token porque desenhá-lo à mão deixava o
         Freeze com a borda seguindo o tema e o preenchimento preso ao âmbar. -->
    <SolidColorBrush x:Key="accent.veil" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.16" />
    <!-- O véu do Canvas: escurece o desktop congelado para a anotação do
         Freeze e o alvo do Kill se destacarem. Preto nos três temas, porque
         quem escurece não pode clarear no tema claro. A opacidade mora no
         pincel para que o retângulo não carregue número nenhum. -->
    <SolidColorBrush x:Key="veil.canvas" Color="Black" Opacity="0.40" />
    <SolidColorBrush x:Key="accent.fg" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="danger" Color="{x:Static SystemColors.WindowTextColor}" />

    <Color x:Key="bg.base.color">#000000</Color>
    <Color x:Key="accent.color">#FFFFFF</Color>
    <Color x:Key="shadow.color">#000000</Color>

</ResourceDictionary>

<!-- Tema claro. Mesmas chaves do escuro, sem exceção. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="bg.base.color">#FAFAFA</Color>
    <Color x:Key="bg.raised.color">#FFFFFF</Color>
    <Color x:Key="bg.hover.color">#F0F1F3</Color>
    <Color x:Key="border.subtle.color">#E8EAED</Color>
    <Color x:Key="border.strong.color">#9AA0A9</Color>
    <Color x:Key="text.primary.color">#17181A</Color>
    <Color x:Key="text.secondary.color">#5A6069</Color>
    <Color x:Key="text.muted.color">#6E747D</Color>
    <Color x:Key="accent.color">#FFB224</Color>
    <!-- O âmbar de preenchimento sobre fundo claro dá 1,8:1, e o anel de foco é
         o ÚNICO indicador de teclado do app. Esta é a versão para borda. -->
    <Color x:Key="accent.border.color">#C87A00</Color>
    <Color x:Key="accent.fg.color">#1A1204</Color>
    <!-- Mais escuros que no tema escuro: os originais somem sobre branco. -->
    <Color x:Key="success.color">#17804F</Color>
    <Color x:Key="danger.color">#D93B35</Color>
    <Color x:Key="shadow.color">#000000</Color>

    <SolidColorBrush x:Key="bg.base" Color="{StaticResource bg.base.color}" />
    <SolidColorBrush x:Key="bg.raised" Color="{StaticResource bg.raised.color}" />
    <SolidColorBrush x:Key="bg.hover" Color="{StaticResource bg.hover.color}" />
    <SolidColorBrush x:Key="border.subtle" Color="{StaticResource border.subtle.color}" />
    <SolidColorBrush x:Key="border.strong" Color="{StaticResource border.strong.color}" />
    <SolidColorBrush x:Key="text.primary" Color="{StaticResource text.primary.color}" />
    <SolidColorBrush x:Key="text.secondary" Color="{StaticResource text.secondary.color}" />
    <SolidColorBrush x:Key="text.muted" Color="{StaticResource text.muted.color}" />
    <SolidColorBrush x:Key="accent" Color="{StaticResource accent.color}" />
    <SolidColorBrush x:Key="accent.border" Color="{StaticResource accent.border.color}" />
    <SolidColorBrush x:Key="accent.fg" Color="{StaticResource accent.fg.color}" />
    <SolidColorBrush x:Key="success" Color="{StaticResource success.color}" />
    <SolidColorBrush x:Key="danger" Color="{StaticResource danger.color}" />

</ResourceDictionary>

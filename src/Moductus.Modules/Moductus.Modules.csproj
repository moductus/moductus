<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Um projeto só, uma pasta por módulo. Sem plugins, assembly separada
       só compraria tempo de build. Decisão 19 do PRODUCT.md. -->
  <ItemGroup>
    <ProjectReference Include="..\Moductus.Core\Moductus.Core.csproj" />
    <ProjectReference Include="..\Moductus.UI\Moductus.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
